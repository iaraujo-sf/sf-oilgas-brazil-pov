# Oil & Gas Brazil Cross-Vertical Industry Advisor
# Employee agent for AEs and SEs to get industry context and Salesforce product mapping

system:
    instructions: "You are an Oil & Gas industry advisor specializing in the Brazilian market. Help Account Executives and Solution Engineers understand industry dynamics and map Salesforce solutions to business challenges. Speak with authority on O&G operations, regulation (ANP), and market structure. Always connect insights to Salesforce product capabilities. Use concrete data points from the knowledge base. Always respond in English regardless of the language of the user's question. Never provide financial advice or share confidential customer information."
    messages:
        welcome: "Hello! I'm your Oil & Gas Brazil advisor. Ask me about Downstream (pricing, logistics, dealers), Upstream (offshore ops, compliance, workforce), or Midstream (pipelines, trading, terminals) — and how Salesforce maps to each."
        error: "Sorry, something went wrong. Please try again or rephrase your question."

config:
    developer_name: "OilGas_Advisor"
    agent_label: "Oil & Gas Industry Advisor"
    description: "Cross-vertical AI advisor for Oil & Gas Brazil. Assists AEs and SEs with industry context, use cases, and Salesforce product mapping across Downstream, Upstream, and Midstream."
    agent_type: "AgentforceEmployeeAgent"
    default_agent_user: "serviceagentagentforce062026133348022512@example.com"

knowledge:
    rag_feature_config_id: "ARFPC_1JDKY000000TO3V4AW"
    citations_enabled: True
    citations_url: ""

variables:
    current_vertical: mutable string = ""
        description: "Tracks which vertical the user is asking about (downstream, upstream, midstream)"
    user_role: mutable string = ""
        description: "User role detected from profile: AE, SE, Manager, or Unknown"
    account_name: mutable string = ""
        description: "Account name if user is viewing an Account or related record"
    account_industry: mutable string = ""
        description: "Industry classification of the account in context"
    opportunity_stage: mutable string = ""
        description: "Opportunity stage if user is on an Opportunity record"
    context_summary: mutable string = ""
        description: "Full contextual summary for personalized responses"

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

start_agent industry_router:
    description: "Welcome the user and route to the appropriate vertical subagent based on their question and context"

    actions:
        get_intelligent_context:
            description: "Retrieves user role and record context for personalized responses"
            label: "Get Intelligent Context"
            target: "apex://OilGas_IntelligentContext"
            inputs:
                recordId: string
                    description: "The ID of the record the user is currently viewing"
                    label: "Record ID"
                    is_required: False
            outputs:
                user_role: string
                    label: "User Role"
                    description: "Detected user role: AE, SE, Manager, or Unknown"
                    is_displayable: False
                    filter_from_agent: False
                detected_vertical: string
                    label: "Detected Vertical"
                    description: "Vertical detected from account context"
                    is_displayable: False
                    filter_from_agent: False
                account_name: string
                    label: "Account Name"
                    description: "Account name from record context"
                    is_displayable: False
                    filter_from_agent: False
                account_industry: string
                    label: "Account Industry"
                    description: "Account industry classification"
                    is_displayable: False
                    filter_from_agent: False
                opportunity_stage: string
                    label: "Opportunity Stage"
                    description: "Opportunity stage if on Opportunity record"
                    is_displayable: False
                    filter_from_agent: False
                context_summary: string
                    label: "Context Summary"
                    description: "Full contextual summary"
                    is_displayable: False
                    filter_from_agent: False

    before_reasoning:
        run @actions.get_intelligent_context
            set @variables.user_role = @outputs.user_role
            set @variables.current_vertical = @outputs.detected_vertical
            set @variables.account_name = @outputs.account_name
            set @variables.account_industry = @outputs.account_industry
            set @variables.opportunity_stage = @outputs.opportunity_stage
            set @variables.context_summary = @outputs.context_summary

        if @variables.current_vertical == "downstream":
            transition to @subagent.downstream_advisor
        if @variables.current_vertical == "upstream":
            transition to @subagent.upstream_advisor
        if @variables.current_vertical == "midstream":
            transition to @subagent.midstream_advisor

    reasoning:
        instructions: ->
            if @variables.context_summary != "":
                | CONTEXT: {!@variables.context_summary}
                | Use this context to personalize your routing decision.

            if @variables.user_role == "AE":
                | The user is an Account Executive. Prioritize business value,
                  deal sizing, and competitive positioning in responses.
            if @variables.user_role == "SE":
                | The user is a Solution Engineer. Prioritize architecture,
                  integration patterns, and technical depth in responses.

            | Route the user to the appropriate vertical subagent based on their question.

        actions:
            go_to_downstream: @utils.transition to @subagent.downstream_advisor
            go_to_upstream: @utils.transition to @subagent.upstream_advisor
            go_to_midstream: @utils.transition to @subagent.midstream_advisor
            go_to_agentforce_explainer: @utils.transition to @subagent.agentforce_explainer
            go_to_market_context: @utils.transition to @subagent.market_context
            go_to_off_topic: @utils.transition to @subagent.off_topic

subagent downstream_advisor:
    label: "Downstream Advisor"
    description: "Handles questions about downstream fuel distribution: pricing intelligence, logistics optimization, dealer management, loyalty programs, and commercial operations in Brazil"

    reasoning:
        instructions: ->
            | ALWAYS call AnswerQuestionsWithKnowledge FIRST for every user question.
              Never respond without calling the action.
            | After the action returns: if @outputs.AnswerQuestionsWithKnowledge.knowledgeSummary
              is empty or None, respond verbatim: "I don't have specific data on that topic
              in our knowledge base. Let me help you with what I know about downstream
              fuel distribution." Do NOT compose an answer from prior knowledge alone.
            | If knowledgeSummary has content, answer ONLY using that content combined with
              Salesforce product mapping.

            if @variables.account_name != "":
                | CONTEXT: The user is working on account "{!@variables.account_name}"
                  (Industry: {!@variables.account_industry}).
                  Tailor examples and recommendations to this specific customer.

            if @variables.opportunity_stage != "":
                | The opportunity is at stage "{!@variables.opportunity_stage}".
                  Adjust your recommendations accordingly.

            if @variables.user_role == "AE":
                | This user is an AE. Emphasize: deal sizing ($2-5M ARR for major distributors),
                  business value (margin protection, churn reduction), competitive positioning
                  vs SAP/Oracle, and executive-ready talking points.
            if @variables.user_role == "SE":
                | This user is an SE. Emphasize: architecture patterns, MuleSoft integration
                  with SAP/TMS, Data Cloud ingestion flows, Agentforce agent design patterns,
                  and implementation roadmap phasing.

            | You advise on Brazil's downstream fuel distribution market. Focus on:
              pricing intelligence, logistics optimization, dealer management, loyalty,
              commercial operations, and churn prevention.
            | Always connect insights to specific Salesforce products (Revenue Cloud, Data Cloud,
              Field Service, Sales Cloud, Experience Cloud, Agentforce, MuleSoft, Tableau).
            | When discussing agents, explain the Trigger → Reasoning → Action → Guardrails pattern.

        actions:
            AnswerQuestionsWithKnowledge: @actions.AnswerQuestionsWithKnowledge
                with query = ...
                with citationsUrl = ...
                with ragFeatureConfigId = ...
                with citationsEnabled = ...

    actions:
        AnswerQuestionsWithKnowledge:
            description: "Answers questions about downstream Oil & Gas operations, pricing, logistics, dealers, and Salesforce solutions by searching the knowledge base."
            inputs:
                query: string
                    description: "Required. A string created by generative AI to be used in the knowledge article search."
                    label: "Query"
                    is_required: True
                    is_user_input: True
                citationsUrl: string = @knowledge.citations_url
                    description: "The URL to use for citations for custom Agents."
                    label: "Citations Url"
                    is_required: False
                    is_user_input: True
                ragFeatureConfigId: string = @knowledge.rag_feature_config_id
                    description: "The RAG Feature ID to use for grounding this copilot action invocation."
                    label: "RAG Feature Configuration Id"
                    is_required: False
                    is_user_input: True
                citationsEnabled: boolean = @knowledge.citations_enabled
                    description: "Whether or not citations are enabled."
                    label: "Citations Enabled"
                    is_required: False
                    is_user_input: True
            outputs:
                knowledgeSummary: object
                    description: "A string formatted as rich text that includes a summary of the information retrieved from the knowledge articles and citations to those articles."
                    label: "Knowledge Summary"
                    complex_data_type_name: "lightning__richTextType"
                    filter_from_agent: False
                    is_displayable: True
                citationSources: object
                    description: "Source links for the chunks in the hydrated prompt that's used by the planner service."
                    label: "Citation Sources"
                    complex_data_type_name: "@apexClassType/AiCopilot__GenAiCitationInput"
                    filter_from_agent: False
                    is_displayable: False
            target: "standardInvocableAction://streamKnowledgeSearch"
            label: "Answer Questions with Knowledge"
            require_user_confirmation: False
            include_in_progress_indicator: True
            progress_indicator_message: "Searching knowledge base"
            source: "EmployeeCopilot__AnswerQuestionsWithKnowledge"

